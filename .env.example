# ---------------------------------------------------------------------------
# Economic Calendar Bias - configuration
# Copy to .env and edit. Every value is optional; the app runs keyless.
# ---------------------------------------------------------------------------

# --- server ---
PORT=4173
HOST=127.0.0.1

# --- price feed (DXY) ---
# auto | twelvedata | finage | proxy
#   auto      -> use a configured key, otherwise the keyless synthetic proxy
#   twelvedata-> real FX legs from Twelve Data, combined with the ICE weights into the
#                DXY index (Twelve Data does not quote the index itself)
#   proxy     -> keyless fallback: ICE-weighted DXY from Coinbase spot FX
PRICE_PROVIDER=auto

# Free-tier keys (twelvedata.com or finage.co.uk).
TWELVE_DATA_KEY=
FINAGE_KEY=
# Symbol used with Finage (DXY on Finage).
PRICE_SYMBOL=DXY

# --- optional LLM analyst layer ---
# Rules always decide the numbers. The model only adds Fed-tone and headline nuance.
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, local llama.cpp, vLLM...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- engine tuning ---
# How long a released event keeps influencing the session score (hours).
EVENT_INFLUENCE_HOURS=18

# --- poll policy (milliseconds) ---
POLL_IDLE_CALENDAR_MS=300000
POLL_ACTIVE_CALENDAR_MS=60000
POLL_NEAR_EVENT_CALENDAR_MS=5000
POLL_NEWS_MS=300000
POLL_NEWS_FAST_MS=60000
POLL_PRICE_MS=60000
POLL_PRICE_FAST_MS=15000
