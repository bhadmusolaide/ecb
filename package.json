{
  "name": "economic-calendar-bias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Translate US macro releases and geopolitics into an actionable DXY bias.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node --test tests/*.test.ts"
  }
}
